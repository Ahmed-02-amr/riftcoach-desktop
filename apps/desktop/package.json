{
  "name": "@riftcoach/desktop",
  "version": "0.4.5",
  "description": "Windows-first League of Legends AI coach desktop app",
  "private": true,
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n renderer,main,electron -c auto \"vite --host 127.0.0.1\" \"tsup --watch\" \"wait-on tcp:5173 file:dist-electron/main/main.js file:dist-electron/preload/preload.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "build": "vite build && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "rebuild:native": "electron-builder install-app-deps --arch=x64",
    "doctor": "powershell -ExecutionPolicy Bypass -File ../../scripts/check-env.ps1",
    "dev:main": "tsup --watch",
    "build:main": "tsup",
    "launch": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron ."
  },
  "dependencies": {
    "@riftcoach/ai": "workspace:*",
    "@riftcoach/core": "workspace:*",
    "@riftcoach/riot": "workspace:*",
    "@riftcoach/storage": "workspace:*",
    "electron-log": "^5.2.4",
    "electron-store": "^10.0.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "nanoid": "^5.0.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "41.7.1",
    "electron-builder": "26.8.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.riftcoach.desktop",
    "productName": "RiftCoach",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "resources/**",
      "package.json",
      "node_modules/**"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "RiftCoach-${version}-Setup.${ext}",
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "**/ffmpeg-static/**",
      "**/ffprobe-static/**"
    ]
  },
  "author": "RiftCoach"
}
